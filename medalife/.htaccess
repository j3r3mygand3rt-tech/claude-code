# ==========================================================================
# MEDALIFE, Serverkonfiguration fuer Apache und LiteSpeed
# Passend fuer klassischen Webspace, etwa Hostinger, All-Inkl oder IONOS.
#
# Jeder Block steht in einem <IfModule>-Rahmen. Fehlt ein Modul auf dem
# Server, wird der Block stillschweigend uebersprungen und die Seite
# funktioniert weiter. Diese Datei kann also nichts kaputt machen.
#
# Auf Netlify oder GitHub Pages wird sie ignoriert, sie darf dort liegen
# bleiben.
# ==========================================================================

# --------------------------------------------------------------------------
# 1. Auf HTTPS umleiten
# Ohne das ist die Seite auch unverschluesselt erreichbar, und der Hinweis
# in der Datenschutzerklaerung auf die TLS-Verschluesselung waere falsch.
# --------------------------------------------------------------------------
<IfModule mod_rewrite.c>
  RewriteEngine On

  # %{HTTPS} statt eines Port-Vergleichs, das funktioniert auch hinter
  # einem Proxy oder Loadbalancer, ohne eine Umleitungsschleife zu bauen.
  RewriteCond %{HTTPS} !=on
  RewriteCond %{HTTP:X-Forwarded-Proto} !https
  RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [R=301,L]
</IfModule>

# --------------------------------------------------------------------------
# 2. Komprimierung
# HTML und Stylesheet bestehen fast nur aus Text und schrumpfen dadurch
# erheblich. Bilder und woff2 sind bereits komprimiert und bleiben aussen vor.
# --------------------------------------------------------------------------
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html
  AddOutputFilterByType DEFLATE text/css
  AddOutputFilterByType DEFLATE text/plain
  AddOutputFilterByType DEFLATE text/xml
  AddOutputFilterByType DEFLATE application/javascript
  AddOutputFilterByType DEFLATE application/json
  AddOutputFilterByType DEFLATE application/ld+json
  AddOutputFilterByType DEFLATE image/svg+xml
</IfModule>

# LiteSpeed, wie es Hostinger einsetzt, nutzt eine eigene Direktive.
<IfModule LiteSpeed>
  SetOutputFilter LSCACHE
</IfModule>

# --------------------------------------------------------------------------
# 3. Zwischenspeicher im Browser
# Schriften und Bilder aendern sich nach dem Livegang nicht mehr und
# koennen lange gehalten werden. HTML dagegen soll bei jedem Besuch neu
# geprueft werden, sonst sieht die Kundschaft eine Textaenderung nicht.
# Wichtig hier, weil der Kursplan und die Kursaenderungen wechseln.
# --------------------------------------------------------------------------
<IfModule mod_expires.c>
  ExpiresActive On

  ExpiresByType font/woff2                "access plus 1 year"
  ExpiresByType image/webp                "access plus 1 year"
  ExpiresByType image/jpeg                "access plus 1 year"
  ExpiresByType image/png                 "access plus 1 year"
  ExpiresByType image/svg+xml             "access plus 1 year"
  ExpiresByType image/x-icon              "access plus 1 year"

  ExpiresByType text/css                  "access plus 1 month"
  ExpiresByType application/javascript    "access plus 1 month"

  # HTML nie aus dem Speicher, immer nachfragen
  ExpiresByType text/html                 "access plus 0 seconds"
</IfModule>

<IfModule mod_headers.c>
  <FilesMatch "\.(woff2|webp|jpe?g|png|svg|ico)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>

  <FilesMatch "\.(css|js)$">
    Header set Cache-Control "public, max-age=2592000"
  </FilesMatch>

  <FilesMatch "\.html$">
    Header set Cache-Control "no-cache, must-revalidate"
  </FilesMatch>

  # --------------------------------------------------------------------
  # 4. Sicherheitskopfzeilen
  # Bewusst ohne Content-Security-Policy: Die Seite laedt nichts von
  # fremden Servern, eine CSP waere hier Zierde. Wer spaeter eine Karte
  # oder ein Buchungswerkzeug einbindet, sollte sie dann ergaenzen.
  # --------------------------------------------------------------------
  Header set X-Content-Type-Options "nosniff"
  Header set Referrer-Policy "strict-origin-when-cross-origin"
  Header set X-Frame-Options "SAMEORIGIN"
  Header set Permissions-Policy "geolocation=(), microphone=(), camera=()"

  # Der Server verraet seine PHP-Version nicht mehr
  Header unset X-Powered-By
</IfModule>

# --------------------------------------------------------------------------
# 5. Richtige Dateitypen
# Manche Hoster kennen woff2 und webp nicht von sich aus und liefern sie
# als application/octet-stream aus, was den Browser sie verwerfen laesst.
# --------------------------------------------------------------------------
<IfModule mod_mime.c>
  AddType font/woff2 .woff2
  AddType image/webp .webp
  AddType image/svg+xml .svg
  AddType application/ld+json .jsonld
</IfModule>

# --------------------------------------------------------------------------
# 6. Startseite und Verzeichnisauflistung
# --------------------------------------------------------------------------
DirectoryIndex index.html
Options -Indexes

# --------------------------------------------------------------------------
# 7. Adressen ohne .html
#
# /preise statt /preise.html. Drei Regeln, die Reihenfolge zaehlt: erst die
# sichtbaren Umleitungen, danach die interne Zuordnung.
#
# Die canonical-Angaben im <head> und die interne Verlinkung sind
# mitgezogen, beide zeigen ebenfalls auf die Adressen ohne Endung. Wer
# diesen Block abschaltet, muss beides zuruecknehmen, sonst zeigen die
# Verweise ins Leere.
# --------------------------------------------------------------------------
<IfModule mod_rewrite.c>
  RewriteEngine On

  # 7a. Die Startseite hat genau eine Adresse: /
  RewriteCond %{THE_REQUEST} \s/+index(\.html)?[\s?] [NC]
  RewriteRule ^ / [R=301,L]

  # 7b. Wer eine Adresse mit .html aufruft, wird dauerhaft auf die Fassung
  # ohne Endung geschickt. Alte Lesezeichen und Links bleiben gueltig.
  RewriteCond %{THE_REQUEST} \s/+(.+?)\.html[\s?] [NC]
  RewriteRule ^ /%1 [R=301,L]

  # 7c. Intern zeigt /preise auf preise.html, ohne sichtbare Umleitung.
  # Verzeichnisse und real vorhandene Dateien bleiben unberuehrt.
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{DOCUMENT_ROOT}/$1.html -f
  RewriteRule ^([^/.]+)/?$ $1.html [L]
</IfModule>

# --------------------------------------------------------------------------
# 8. Umleitungen von den alten WordPress-Adressen
# Die bisherige Seite hatte mehr Einzelseiten als diese. Damit Treffer aus
# Suchmaschinen und alte Lesezeichen nicht auf einer Fehlerseite landen,
# zeigt jede alte Adresse auf die Stelle, an der ihr Inhalt jetzt steht.
# --------------------------------------------------------------------------
<IfModule mod_rewrite.c>
  RewriteEngine On

  RewriteRule ^physiotherapeutisches-beckenboden-training/?$ /physiotherapie#beckenboden [R=301,L]
  RewriteRule ^trainingsbereich/?$ /training [R=301,L]
  RewriteRule ^kursplan/?$ /training#kurse [R=301,L]
  RewriteRule ^kursbeschreibung/?$ /training#kursinhalte [R=301,L]
  RewriteRule ^konditionen/?$ /preise [R=301,L]
  RewriteRule ^ueber_medalife/?$ / [R=301,L]
  RewriteRule ^faqs/?$ /faq [R=301,L]
  RewriteRule ^stellenangebote/?$ /team [R=301,L]
  RewriteRule ^aktuelles/?$ / [R=301,L]
</IfModule>
