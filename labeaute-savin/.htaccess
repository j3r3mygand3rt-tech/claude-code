# ==========================================================================
# La Beaute de Savin, Serverkonfiguration fuer Apache und LiteSpeed
# Passend fuer klassischen Webspace, etwa Hostinger, All-Inkl oder IONOS.
#
# Jeder Block steht in einem <IfModule>-Rahmen. Fehlt ein Modul auf dem
# Server, wird der Block stillschweigend uebersprungen und die Seite
# funktioniert weiter. Diese Datei kann also nichts kaputt machen.
#
# Auf Netlify oder GitHub Pages wird sie ignoriert, sie darf dort liegen
# bleiben.
# ==========================================================================

# --------------------------------------------------------------------------
# 1. Auf HTTPS umleiten
# Ohne das ist die Seite auch unverschluesselt erreichbar, und der Hinweis
# in der Datenschutzerklaerung auf die TLS-Verschluesselung waere falsch.
# --------------------------------------------------------------------------
<IfModule mod_rewrite.c>
  RewriteEngine On

  # %{HTTPS} statt eines Port-Vergleichs, das funktioniert auch hinter
  # einem Proxy oder Loadbalancer, ohne eine Umleitungsschleife zu bauen.
  RewriteCond %{HTTPS} !=on
  RewriteCond %{HTTP:X-Forwarded-Proto} !https
  RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [R=301,L]
</IfModule>

# --------------------------------------------------------------------------
# 2. Komprimierung
# Das HTML der Startseite sind rund 56 KB, das Stylesheet 39 KB. Beide
# bestehen fast nur aus Text und schrumpfen dadurch erheblich.
# Bilder und woff2 sind bereits komprimiert und bleiben aussen vor.
# --------------------------------------------------------------------------
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html
  AddOutputFilterByType DEFLATE text/css
  AddOutputFilterByType DEFLATE text/plain
  AddOutputFilterByType DEFLATE text/xml
  AddOutputFilterByType DEFLATE application/javascript
  AddOutputFilterByType DEFLATE application/json
  AddOutputFilterByType DEFLATE application/ld+json
  AddOutputFilterByType DEFLATE image/svg+xml
</IfModule>

# LiteSpeed, wie es Hostinger einsetzt, nutzt eine eigene Direktive.
<IfModule LiteSpeed>
  SetOutputFilter LSCACHE
</IfModule>

# --------------------------------------------------------------------------
# 3. Zwischenspeicher im Browser
# Schriften und Bilder aendern sich nach dem Livegang nicht mehr und
# koennen lange gehalten werden. HTML dagegen soll bei jedem Besuch neu
# geprueft werden, sonst sieht die Kundin eine Textaenderung nicht.
# --------------------------------------------------------------------------
<IfModule mod_expires.c>
  ExpiresActive On

  ExpiresByType font/woff2                "access plus 1 year"
  ExpiresByType image/webp                "access plus 1 year"
  ExpiresByType image/jpeg                "access plus 1 year"
  ExpiresByType image/png                 "access plus 1 year"
  ExpiresByType image/svg+xml             "access plus 1 year"
  ExpiresByType image/x-icon              "access plus 1 year"

  ExpiresByType text/css                  "access plus 1 month"
  ExpiresByType application/javascript    "access plus 1 month"

  # HTML nie aus dem Speicher, immer nachfragen
  ExpiresByType text/html                 "access plus 0 seconds"
</IfModule>

<IfModule mod_headers.c>
  <FilesMatch "\.(woff2|webp|jpe?g|png|svg|ico)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>

  <FilesMatch "\.(css|js)$">
    Header set Cache-Control "public, max-age=2592000"
  </FilesMatch>

  <FilesMatch "\.html$">
    Header set Cache-Control "no-cache, must-revalidate"
  </FilesMatch>

  # --------------------------------------------------------------------
  # 4. Sicherheitskopfzeilen
  # Bewusst ohne Content-Security-Policy: Die Seite laedt nichts von
  # fremden Servern, eine CSP waere hier Zierde. Wer spaeter eine Karte
  # oder ein Buchungswerkzeug einbindet, sollte sie dann ergaenzen.
  # --------------------------------------------------------------------
  Header set X-Content-Type-Options "nosniff"
  Header set Referrer-Policy "strict-origin-when-cross-origin"
  Header set X-Frame-Options "SAMEORIGIN"
  Header set Permissions-Policy "geolocation=(), microphone=(), camera=()"

  # Der Server verraet seine PHP-Version nicht mehr
  Header unset X-Powered-By
</IfModule>

# --------------------------------------------------------------------------
# 5. Richtige Dateitypen
# Manche Hoster kennen woff2 und webp nicht von sich aus und liefern sie
# als application/octet-stream aus, was den Browser sie verwerfen laesst.
# --------------------------------------------------------------------------
<IfModule mod_mime.c>
  AddType font/woff2 .woff2
  AddType image/webp .webp
  AddType image/svg+xml .svg
  AddType application/ld+json .jsonld
</IfModule>

# --------------------------------------------------------------------------
# 6. Startseite und Verzeichnisauflistung
# --------------------------------------------------------------------------
DirectoryIndex index.html
Options -Indexes

# --------------------------------------------------------------------------
# 7. Adressen ohne .html, bewusst abgeschaltet
#
# Der folgende Block macht aus /leistungen.html die Adresse /leistungen.
# Das sieht aufgeraeumter aus, ist hier aber nicht eingeschaltet, weil es
# drei Stellen betrifft, die zusammenpassen muessen:
#
#   1. die canonical-Angaben im <head>, die derzeit auf .html zeigen
#   2. die interne Verlinkung, die derzeit .html nutzt und sonst bei
#      jedem Klick durch eine 301-Umleitung laufen wuerde
#   3. die Sitemap, falls spaeter eine angelegt wird
#
# Nur den Server umzustellen wuerde bedeuten, dass jede Seite unter zwei
# Adressen erreichbar ist und die canonical-Angabe auf eine Adresse zeigt,
# die selbst weiterleitet. Wer saubere Adressen will, sagt Bescheid: dann
# werden canonical und interne Links mitgezogen und dieser Block aktiv.
# --------------------------------------------------------------------------
# <IfModule mod_rewrite.c>
#   RewriteEngine On
#
#   RewriteCond %{REQUEST_FILENAME} !-d
#   RewriteCond %{REQUEST_FILENAME}\.html -f
#   RewriteRule ^([^\.]+)$ $1.html [L]
#
#   RewriteCond %{THE_REQUEST} \s/+(.+)\.html[\s?] [NC]
#   RewriteRule ^ /%1 [R=301,L]
# </IfModule>
